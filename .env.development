# macOS: Port 3000 kollidiert oft mit AirTunes → POST /search → HTTP 403.
# Port wird zusätzlich in package.json „npm start“ fest auf 3002 gesetzt (zuverlässiger als nur diese Datei).
PORT=3002

# API direkt zum Flask-Backend (umgeht den Dev-Proxy komplett; CORS ist im Backend aktiv).
REACT_APP_API_BASE_URL=http://127.0.0.1:5001
